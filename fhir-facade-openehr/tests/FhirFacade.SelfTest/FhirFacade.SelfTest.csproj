<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Compiles the facade's own source files, minus Program.cs, so it needs no NuGet package. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>FhirFacade.SelfTest</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/FhirFacade/**/*.cs" Exclude="../../src/FhirFacade/Program.cs;../../src/FhirFacade/bin/**;../../src/FhirFacade/obj/**" LinkBase="Facade" />
    <None Include="recorded/*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
