@* Sits inside the AgentBoundary. When the thread came from storage, asks the agent to rebuild the conversation from it. *@
@inject ILogger<RestoreOnLoad> Logger

@if (_failed)
{
    <p class="desk__error" role="alert">This conversation could not be opened. <a href="/">Start a new one</a>.</p>
}
else if (Thread.EndedMidTurn)
{
    <p class="desk__notice" role="status">The last answer was interrupted before it finished. What arrived is shown.</p>
}

@if (_done)
{
    <span data-restored="@Thread.RestoredUpdates" hidden></span>
}

@code {
    private bool _failed;
    private bool _done;

    [CascadingParameter]
    public AgentContext AgentContext { get; set; } = default!;

    [Parameter, EditorRequired]
    public JournalThread Thread { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (Thread.RestoredUpdates > 0)
            {
                await AgentContext.RestoreAsync(CancellationToken.None);
            }
        }
        catch (Exception error)
        {
            // An exception here would end the circuit and leave a dead page. Stored data is input: it can be wrong.
            Logger.LogError(error, "Conversation {Thread} could not be restored", Thread.ThreadId);
            _failed = true;
        }

        _done = true;
    }
}
