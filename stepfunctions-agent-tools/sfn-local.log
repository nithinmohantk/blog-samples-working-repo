eption\", \"Lambda.TooManyRequestsException\", \"Lambda.SdkClientException\"],\n          \"IntervalSeconds\": 1,\n          \"MaxAttempts\": 3,\n          \"BackoffRate\": 2\n        }\n      ],\n      \"Next\": \"IsEligible\"\n    },\n    \"IsEligible\": {\n      \"Type\": \"Choice\",\n      \"Choices\": [\n        { \"Variable\": \"$.validation.eligible\", \"BooleanEquals\": true, \"Next\": \"RouteByAmount\" }\n      ],\n      \"Default\": \"RejectIneligible\"\n    },\n    \"RouteByAmount\": {\n      \"Comment\": \"The limits live here. No wording in a prompt can move them.\",\n      \"Type\": \"Choice\",\n      \"Choices\": [\n        { \"Variable\": \"$.amountCents\", \"NumericLessThanEquals\": 5000, \"Next\": \"ApplyCredit\" },\n        { \"Variable\": \"$.amountCents\", \"NumericLessThanEquals\": 50000, \"Next\": \"ManagerApproval\" }\n      ],\n      \"Default\": \"RejectOverLimit\"\n    },\n    \"ManagerApproval\": {\n      \"Comment\": \"Waits for a person. The task token goes to the approval worker, never to the agent.\",\n      \"Type\": \"Task\",\n      \"Resource\": \"arn:aws:states:us-east-1:123456789012:activity:ManagerApproval\",\n      \"TimeoutSeconds\": 86400,\n      \"ResultPath\": \"$.approval\",\n      \"Catch\": [\n        { \"ErrorEquals\": [\"States.Timeout\"], \"ResultPath\": \"$.error\", \"Next\": \"ApprovalExpired\" }\n      ],\n      \"Next\": \"ApprovalDecision\"\n    },\n    \"ApprovalDecision\": {\n      \"Type\": \"Choice\",\n      \"Choices\": [\n        { \"Variable\": \"$.approval.approved\", \"BooleanEquals\": true, \"Next\": \"ApplyCredit\" }\n      ],\n      \"Default\": \"Declined\"\n    },\n    \"ApplyCredit\": {\n      \"Comment\": \"The only state that moves money. The execution name is the idempotency key.\",\n      \"Type\": \"Task\",\n      \"Resource\": \"arn:aws:states:::lambda:invoke\",\n      \"Parameters\": {\n        \"FunctionName\": \"credit-apply\",\n        \"Payload\": {\n          \"caseId.$\": \"$.caseId\",\n          \"amountCents.$\": \"$.amountCents\",\n          \"idempotencyKey.$\": \"$$.Execution.Name\"\n        }\n      },\n      \"ResultSelector\": {\n        \"creditId.$\": \"$.Payload.creditId\"\n      },\n      \"ResultPath\": \"$.credit\",\n      \"TimeoutSeconds\": 10,\n      \"Retry\": [\n        {\n          \"ErrorEquals\": [\"Lambda.ServiceException\", \"Lambda.TooManyRequestsException\", \"Lambda.SdkClientException\"],\n          \"IntervalSeconds\": 1,\n          \"MaxAttempts\": 3,\n          \"BackoffRate\": 2\n        }\n      ],\n      \"Next\": \"Credited\"\n    },\n    \"Credited\": {\n      \"Type\": \"Pass\",\n      \"Parameters\": {\n        \"outcome\": \"CREDITED\",\n        \"caseId.$\": \"$.caseId\",\n        \"amountCents.$\": \"$.amountCents\",\n        \"creditId.$\": \"$.credit.creditId\"\n      },\n      \"End\": true\n    },\n    \"Declined\": {\n      \"Type\": \"Pass\",\n      \"Parameters\": { \"outcome\": \"DECLINED\", \"reason\": \"The approver declined the credit.\" },\n      \"End\": true\n    },\n    \"ApprovalExpired\": {\n      \"Type\": \"Pass\",\n      \"Parameters\": { \"outcome\": \"EXPIRED\", \"reason\": \"Nobody approved the credit in time.\" },\n      \"End\": true\n    },\n    \"RejectInvalidInput\": {\n      \"Type\": \"Pass\",\n      \"Parameters\": { \"outcome\": \"REJECTED\", \"reason\": \"caseId must be a string and amountCents a positive number.\" },\n      \"End\": true\n    },\n    \"RejectIneligible\": {\n      \"Type\": \"Pass\",\n      \"Parameters\": { \"outcome\": \"REJECTED\", \"reason.$\": \"$.validation.reason\" },\n      \"End\": true\n    },\n    \"RejectOverLimit\": {\n      \"Type\": \"Pass\",\n      \"Parameters\": { \"outcome\": \"REJECTED\", \"reason\": \"Above the limit for a goodwill credit. Open a refund case instead.\" },\n      \"End\": true\n    }\n  }\n}\n","roleArn":"arn:aws:iam::123456789012:role/local-only","type":null,"loggingConfiguration":null,"tags":null,"tracingConfiguration"